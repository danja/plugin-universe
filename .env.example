# Copy to .env and fill in. Every value is required: there are no inline
# fallbacks, so a missing value is an error rather than a silent default.

SPARQL_URL_BASE=http://localhost:3030
SPARQL_DATASET=plugin-universe
SPARQL_USER=admin
SPARQL_PASSWORD=admin

OLLAMA_URL=http://localhost:11434

# Where the seed git checkouts live. Bind-mounted read-only at /srv/seed, so
# this directory must contain `downspout/` and `flues/`. Defaults to
# ./data/seed. An empty or missing directory is fine — the ingest reports each
# absent source as skipped and carries on with the rest.
# SEED_DIR=/home/github

# Memory. Defaults suit a 4 GB server; raise them on a larger one. Fuseki and
# Ollama are given no swap deliberately — see the note in docker-compose.yml.
# The app figure comes from measurement: 48 MB resident serving 645 plugins.
# FUSEKI_HEAP=1g
# FUSEKI_MEM=1400m
# OLLAMA_MEM=1600m
# OLLAMA_KEEP_ALIVE=30m
# NODE_HEAP=256
# APP_MEM=384m
# NGINX_MEM=96m

# Lifts the GitHub API rate limit from 60 requests an hour to 5,000. That is the
# only reason it exists: everything the harvester reads is public.
#
# Grant it NO scopes. A fine-grained token wants "Public Repositories
# (read-only)" with no permissions beyond the Metadata read that is automatic;
# a classic token wants no scopes ticked at all. Both still read public data and
# both still get the 5,000/hour limit.
#
# Do not grant public_repo — despite the name it is a write scope. Do not grant
# read:user or user:email: maintainer names and project roles are catalogue
# data, email addresses are not (docs/resources.md §4, rule 4), and the surest
# way to keep that rule is to hold a token that cannot read them.
# Harvesting only, and only for bin/discover.js and bin/ingest.js --github.
# The serving app never reads it: leaving it unset is a valid configuration and
# is the right one between sweeps, since a token that does not exist cannot be
# abused. Not part of the OAuth App — this is a personal access token from
# Settings -> Developer settings -> Personal access tokens, with NO scopes.
GITHUB_TOKEN=

## ── Phase 3: sign-in ────────────────────────────────────────────────────────
## Not yet read by anything. Present so the values have a home and the
## reasoning is where the next person looks for it.

# From the GitHub OAuth App (github.com/settings/developers → OAuth Apps).
# Not a GitHub App: for identity alone, a GitHub App adds an installation flow
# for no benefit. Callback URL https://plugin-universe.com/auth/callback, and
# Device Flow left OFF — the site is a browser app, and an enabled-but-unused
# device flow is the basis of a known phishing pattern where the victim is shown
# a genuine GitHub page and asked to type in an attacker's code.
#
# An OAuth App has no scopes field: scopes are asked for per-authorisation, in
# the authorize URL. We request none, which returns login, id, avatar_url and
# name — and deliberately not the email address, per the rule above. The access
# token is used once to call /user and then discarded; identity is all we want,
# and keeping the token would be holding a credential for no reason.
#
# The id is public and appears in the authorize URL. The secret is a credential.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The HMAC key that signs session cookies.
#
# Sessions are stateless — a signed cookie carrying an account id, with no
# session table behind it — so this key *is* the whole security of a session.
# Anyone holding it can mint a cookie for any account, including an admin one.
# It is not a password: do not choose it, generate it.
#
#   openssl rand -base64 32
#
# or, equivalently:
#
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# 32 bytes. Longer buys nothing against an HMAC; shorter is the only mistake
# available here.
#
# Three things follow from it being stateless:
#
#  - It must stay the same across restarts and deploys. Generating one at boot
#    would sign everybody out on every restart.
#  - Rotating it signs everybody out, immediately and by design. That is the
#    lever to pull if it ever leaks, and it is the only one — there is no
#    session table to clear.
#  - Development and production want different values, so a dev cookie is not a
#    production cookie.
SESSION_SECRET=

# The public origin, used to build the OAuth callback URL. Must match the
# Authorization callback URL registered on the GitHub OAuth App, host and path.
# Defaults to site.origin in config/config.json, which is production; a local
# development instance needs its own app and its own value here.
#
#   SITE_ORIGIN=http://localhost:4100

# ── Payments (optional) ──────────────────────────────────────────────────────
# Unset means the catalogue runs read-only with no paid features, which is a
# legitimate deployment. Set *both* keys or neither — one alone is a half-built
# payment system and the app says so on /health rather than pretending.
#
# Test keys start sk_test_ / pk_test_ and move no money. The app refuses to
# start if the two keys are for different modes: a live publishable key with a
# test secret produces a checkout that looks right and settles nowhere.
STRIPE_SECRET_KEY=
STRIPE_PUBLIC_KEY=

# The webhook signing secret, from the endpoint you create in the Stripe
# dashboard — or from `stripe listen`, which issues a *different* one for local
# forwarding.
#
# This is the security boundary of the whole feature, not a detail. Every
# webhook delivery is an instruction to give something away — a year of paid
# placement, a paid account tier — and the endpoint is a public URL. Without
# this the app cannot tell Stripe's delivery from anyone else's POST, so it
# refuses every delivery rather than trusting them.
STRIPE_WEBHOOK_SECRET=
