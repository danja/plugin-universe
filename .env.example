# Copy to .env and fill in. Every value is required: there are no inline
# fallbacks, so a missing value is an error rather than a silent default.

SPARQL_URL_BASE=http://localhost:3030
SPARQL_DATASET=plugin-universe
SPARQL_USER=admin
SPARQL_PASSWORD=admin

OLLAMA_URL=http://localhost:11434

# Lifts the GitHub API rate limit from 60 requests an hour to 5,000. That is the
# only reason it exists: everything the harvester reads is public.
#
# Grant it NO scopes. A fine-grained token wants "Public Repositories
# (read-only)" with no permissions beyond the Metadata read that is automatic;
# a classic token wants no scopes ticked at all. Both still read public data and
# both still get the 5,000/hour limit.
#
# Do not grant public_repo — despite the name it is a write scope. Do not grant
# read:user or user:email: maintainer names and project roles are catalogue
# data, email addresses are not (docs/resources.md §4, rule 4), and the surest
# way to keep that rule is to hold a token that cannot read them.
GITHUB_TOKEN=
