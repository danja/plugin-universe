# Facet counts for the search UI: how many plugins carry each format, role,
# category, licence, platform, source availability and price. Driven by the data
# rather than a hardcoded list, so a new source adding a category makes it
# appear.
#
# "source" and "pricing" answer the two questions asked most often about a
# plugin — can I see the source, do I have to pay — and are worth facets of
# their own rather than being buried in the licence string. "platform" is the
# third: a Windows user reading a catalogue three quarters of which is Linux
# audio software is asking it on every page.
#
# The conditions placeholder narrows the plugins counted, with the same patterns as
# plugin/filter, or is empty for the whole catalogue. One query rather than a
# filtered copy of this one, so the facets counted and the facets offered cannot
# drift apart. The conditions sit outside the GRAPH block because each carries
# its own; a measurement verdict lives in a run graph, not the plugin's.
SELECT ?facet ?value (COUNT(DISTINCT ?plugin) AS ?count)
WHERE {
  GRAPH ?g {
    ?plugin a trn:PluginProfile .
    {
      ?plugin trn:format ?v . BIND("format" AS ?facet)
    } UNION {
      ?plugin trn:role ?v . BIND("role" AS ?facet)
    } UNION {
      ?plugin trn:accepts ?v . BIND("accepts" AS ?facet)
    } UNION {
      ?plugin trn:produces ?v . BIND("produces" AS ?facet)
    } UNION {
      ?plugin pu:category ?v . BIND("category" AS ?facet)
    } UNION {
      ?plugin pu:sourceAvailability ?v . BIND("source" AS ?facet)
    } UNION {
      ?plugin pu:pricing ?v . BIND("pricing" AS ?facet)
    } UNION {
      ?plugin pu:supportedPlatform ?v . BIND("platform" AS ?facet)
    } UNION {
      ?plugin pu:licenceId ?vendorName . BIND("licence" AS ?facet)
    } UNION {
      ?plugin trn:vendor ?vendorName . BIND("vendor" AS ?facet)
    }
    BIND(COALESCE(?vendorName, REPLACE(STR(?v), "^.*/", "")) AS ?value)
  }
  ${conditions}
}
GROUP BY ?facet ?value
ORDER BY ?facet DESC(?count) ?value
