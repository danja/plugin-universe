# Everything the embedding pipeline needs to compose a plugin's retrieval text,
# everything the lexical signal matches against, and the provenance a profile
# page has to show: which source graph the plugin came from, its own homepage,
# the document the source published about it, and the image the source published
# of it.
#
# GROUP_CONCAT keeps this to one row per plugin: the alternative is a join
# explosion across roles, categories and 900-odd ports.
SELECT ?plugin ?g ?name ?vendor ?description ?homepage ?seeAlso ?created ?licenceId ?sourceAvailability ?pricing
       (GROUP_CONCAT(DISTINCT ?roleLabel; separator=", ") AS ?roles)
       (GROUP_CONCAT(DISTINCT ?categoryLabel; separator=", ") AS ?categories)
       (GROUP_CONCAT(DISTINCT ?formatLabel; separator=", ") AS ?formats)
       (GROUP_CONCAT(DISTINCT ?tag; separator=", ") AS ?tags)
       (GROUP_CONCAT(DISTINCT ?portName; separator=", ") AS ?parameters)
       (GROUP_CONCAT(DISTINCT ?altLabel; separator=", ") AS ?categoryAltLabels)
       (GROUP_CONCAT(DISTINCT ?caution; separator=" ") AS ?cautions)
       # Depictions are looked for in every graph, not only the one that
       # declares the plugin. An image uploaded here lands in the contributor's
       # own graph, and scoped to the plugin's graph it was invisible — the
       # picture was in the catalogue and on no page. Concatenated because a
       # plugin can have a harvested image and an uploaded one; which to show
       # is the caller's, and it prefers the local one.
       (GROUP_CONCAT(DISTINCT ?anyImage; separator=" ") AS ?images)
WHERE {
  GRAPH ?g {
    ?plugin a trn:PluginProfile ; rdfs:label ?name .
    OPTIONAL { ?plugin trn:vendor ?vendor }
    OPTIONAL { ?plugin rdfs:comment ?description }
    OPTIONAL { ?plugin trn:caution ?caution }
    OPTIONAL { ?plugin foaf:homepage ?homepage }
    OPTIONAL { ?plugin rdfs:seeAlso ?seeAlso }
    OPTIONAL { ?plugin dcterms:created ?created }
    OPTIONAL { ?plugin pu:licenceId ?licenceId }
    OPTIONAL { ?plugin pu:sourceAvailability ?sourceAvailability }
    OPTIONAL { ?plugin pu:pricing ?pricing }
    OPTIONAL { ?plugin trn:role ?role      BIND(REPLACE(STR(?role), "^.*/", "") AS ?roleLabel) }
    OPTIONAL { ?plugin trn:format ?format  BIND(REPLACE(STR(?format), "^.*/", "") AS ?formatLabel) }
    OPTIONAL { ?plugin pu:category ?cat    BIND(REPLACE(STR(?cat), "^.*/", "") AS ?categoryLabel) }
    OPTIONAL { ?plugin pu:tag ?tag }
    OPTIONAL { ?plugin lv2:port ?port . ?port lv2:name ?portName }
    # What else a category is called, from the concept scheme in its own graph.
    # These feed the lexical signal only, so that searching "reverberation" or
    # "echo" reaches the same plugins as "reverb" or "delay". Deliberately not
    # part of the composed text the embeddings are built from: adding them there
    # would invalidate every stored vector for a signal the lexical index gives
    # away free.
    #
    # The category is re-matched here rather than reusing ?cat from the OPTIONAL
    # above. Sharing it looked equivalent and was not: for a plugin with no
    # category ?cat is unbound, so the join was unconstrained and every plugin
    # without a category collected all 134 alt labels in the scheme — becoming
    # lexically matchable by every synonym in the taxonomy.
    OPTIONAL {
      ?plugin pu:category ?altCat .
      GRAPH ?scheme { ?altCat skos:altLabel ?altLabel }
    }
  }

  # Depictions in any graph, not only the one that declares the plugin. An
  # image uploaded here lands in the contributor's own graph, and scoped to the
  # plugin's graph it was invisible — the picture in the catalogue and on no
  # page.
  OPTIONAL { GRAPH ?depictionGraph { ?plugin foaf:depiction ?anyImage } }
}
GROUP BY ?plugin ?g ?name ?vendor ?description ?homepage ?seeAlso ?created ?licenceId ?sourceAvailability ?pricing
ORDER BY ?name
