# Record a moderator's decision on a correction.
#
# A DELETE of whatever status is there rather than of the one expected: a
# correction with two statuses is the case worth collapsing, and deleting by
# value would leave the other behind.
DELETE { GRAPH ${queueGraph} { ${correction} pu:correctionStatus ?old } }
INSERT {
  GRAPH ${queueGraph} {
    ${correction} pu:correctionStatus ${status} ;
                  pu:reviewedBy ${moderator} ;
                  pu:reviewedAt ${at} .
  }
}
WHERE { GRAPH ${queueGraph} { ${correction} pu:correctionStatus ?old } }
