# The other half of a bundle: this is where `a lv2:Plugin` actually lives, and
# it holds no ports at all. Reading this file alone must fail with a message
# that says where to look instead.
@prefix lv2:  <http://lv2plug.in/ns/lv2core#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/plugins/fixture>
    a lv2:Plugin ;
    lv2:binary <fixture.so> ;
    rdfs:seeAlso <plugin.ttl> .
